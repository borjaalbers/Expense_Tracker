# Environment variables for Expense Tracker
# Copy this file to `.env` and fill in actual values before running locally.

# Flask session secret (required)
FLASK_SECRET_KEY=change-me-in-production

# Optional: override SQLite with PostgreSQL/MySQL/etc.
# Example: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=

# Optional: port for local dev (default 5001)
PORT=5001

# Optional: comma-separated default categories overriding config defaults
DEFAULT_CATEGORIES=
